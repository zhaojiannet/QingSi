# 复制成 .env 再改：cp .env.example .env。给 compose 用，程序读的变量在 app/.env

# compose 项目名，也是容器名前缀和 docker-net 上的访问名，OrbStack 域名是 app.<项目名>.orb.local，前端按这个名字转发接口
COMPOSE_PROJECT_NAME=qingsi-backend

# 容器的时区，只影响日志时间；业务日期按代码里固定的 +08:00 算
TZ=Asia/Shanghai

# 下面几项只有 compose.prod.yaml 用
HOST_PORT=3000
# 先跑数据库迁移和初始化管理员，再起服务
NODE_ENTRY=scripts/start.js
# Prisma 生成的客户端是 TypeScript，要靠 tsx 加载
NODE_OPTIONS=--import tsx
