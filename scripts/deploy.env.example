# scripts/deploy.sh 的配置。复制为 scripts/deploy.env 后填写，该文件不入版本库。
# 只说明「往哪台机器的哪两个目录推」，跟服务器上后端的 .env（数据库、密钥）无关，
# 部署脚本永远不会覆盖服务器上的 .env。

# ssh 目标。可以是 user@host，也可以是 ~/.ssh/config 里的别名。需已配好免密登录
SERVER="root@your-domain.com"

# 前端静态文件目录，必须与建站时设定的网站根目录一致，否则文件推上去了访问不到
FRONT_DIR="/srv/www/your-domain.com/index"

# 后端代码目录，必须是后端容器挂载为 /app 的那个宿主机目录，否则容器里看不到新代码
BACK_DIR="/srv/www/your-domain.com/backend"

# 服务器上跑后端的容器名，填 docker ps 里显示的名字，不是镜像名
BACK_CONTAINER="node_your-project"

# 站点地址，部署完访问 ${SITE_URL}/api/configs 做健康检查
SITE_URL="https://your-domain.com"
